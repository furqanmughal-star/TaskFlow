# Cloud sync (Supabase) — optional.
# Without these two values the app still works fully offline (data stays on the device).
# Get them from: Supabase dashboard -> Project Settings -> API.
# The anon key is meant to be public; your data is protected by the row-level security in supabase/schema.sql.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"
